            {
              "name": "name",
              "label": "log name",
              "default": "nav.log"
            }
          ]
        },
        {
          "id": "dashboard",
          "label": "Flight recorder dashboard",
          "hint": "GETs /dashboard (recent lines across sources).",
          "fields": []
        }
      ]
    },
