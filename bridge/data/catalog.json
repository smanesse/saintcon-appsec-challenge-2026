            },
            {
              "name": "body_json",
              "label": "body JSON",
              "default": ""
            },
            {
              "name": "version",
              "label": "version",
              "default": ""
            },
            {
              "name": "module",
              "label": "module",
              "default": ""
            },
            {
              "name": "status",
              "label": "status",
              "default": ""
            }
          ]
        }
      ]
    },
    {
      "code": "MQB",
      "name": "DRONE TELEMETRY BUS",
      "service": "mqtt-module",
      "realName": "Python MQTT 3.1.1 broker",
      "port": 1883,
      "adminPort": 8082,
      "proto": "tcp",
      "desc": "Carries drone-swarm telemetry over MQTT 3.1.1.",
      "actions": [
        {
          "id": "roundtrip",
          "label": "Publish / subscribe round-trip",
          "hint": "Connects two real MQTT clients, subscribes, publishes, and confirms delivery.",
          "fields": [
            {
              "name": "topic",
              "label": "topic",
              "default": "bridge/telemetry"
            },
            {
              "name": "message",
              "label": "message",
              "default": "ping from bridge"
            },
            {
              "name": "password",
              "label": "password (optional)",
              "default": "",
              "placeholder": "blank = the console's own sign-in"
            }
          ]
        },
        {
          "id": "connect",
          "label": "CONNECT (hold session)",
          "hint": "Sends CONNECT/CONNACK and holds the socket for the other actions. The console signs in for you unless you give your own password.",
          "fields": [
            {
              "name": "client_id",
              "label": "client id",
              "default": "mqb-cockpit"
            },
            {
              "name": "password",
              "label": "password (optional)",
              "default": "",
              "placeholder": "blank = the console's own sign-in"
            },
            {
              "name": "keep_alive",
              "label": "keep alive s",
              "default": "30"
            },
            {
              "name": "will_topic",
              "label": "will topic",
              "default": "will/lost"
            },
            {
              "name": "will_message",
              "label": "will message",
              "default": "IF THIS LINE DROPS PLAY THIS"
            }
          ]
        },
        {
          "id": "publish",
          "label": "PUBLISH",
          "hint": "PUBLISH on a held session. qos=1 waits for PUBACK. Empty message + retain clears a retained topic.",
          "fields": [
            {
              "name": "client_id",
              "label": "client id",
              "default": "mqb-cockpit"
            },
            {
              "name": "topic",
              "label": "topic",
              "default": "hull/temp"
            },
            {
              "name": "message",
              "label": "payload",
              "default": ""
            },
            {
              "name": "qos",
              "label": "QoS",
              "default": "0",
              "options": [
                "0",
                "1"
              ]
            },
            {
              "name": "retain",
              "label": "retain",
              "default": "false",
              "options": [
                "false",
                "true"
              ]
            }
          ]
        },
        {
          "id": "subscribe",
          "label": "SUBSCRIBE",
          "hint": "SUBSCRIBE a filter on a held session. Matching retained messages come back on the same call.",
          "fields": [
            {
              "name": "client_id",
              "label": "client id",
              "default": "mqb-cockpit"
            },
            {
              "name": "topic",
              "label": "filter",
              "default": "drone/+"
            },
            {
              "name": "qos",
              "label": "QoS",
              "default": "0",
              "options": [
                "0",
                "1"
              ]
            }
          ]
        },
        {
          "id": "unsubscribe",
          "label": "UNSUBSCRIBE",
          "hint": "UNSUBSCRIBE a filter. Session stays connected.",
          "fields": [
            {
              "name": "client_id",
              "label": "client id",
              "default": "mqb-cockpit"
            },
            {
              "name": "topic",
              "label": "filter",
              "default": "drone/+"
            }
          ]
        },
        {
          "id": "ping",
          "label": "PINGREQ",
          "hint": "PINGREQ on a held session; waits for PINGRESP.",
          "fields": [
            {
              "name": "client_id",
              "label": "client id",
              "default": "mqb-cockpit"
            }
          ]
        },
        {
          "id": "drain",
          "label": "Read messages",
          "hint": "Messages the broker delivered to a held session since the last read.",
          "fields": [
            {
              "name": "client_id",
              "label": "client id",
              "default": "mqb-cockpit"
            }
          ]
        },
        {
          "id": "disconnect",
          "label": "DISCONNECT",
          "hint": "graceful=true sends DISCONNECT then close (will suppressed). false is a TCP drop (will fires).",
          "fields": [
            {
              "name": "client_id",
              "label": "client id",
              "default": "mqb-cockpit"
            },
            {
              "name": "graceful",
              "label": "graceful",
              "default": "true",
              "options": [
                "true",
                "false"
              ]
            }
          ]
        },
        {
          "id": "stats",
          "label": "Admin stats",
          "hint": "Connected client and retained message counts from the admin port.",
          "fields": []
        }
      ]
    },
