{
  "ship": {
    "name": "USS AUDITOR-7",
    "registry": "SC-2026",
    "callsign": "BLUE-TEAM"
  },
  "subsystems": [
    {
      "code": "FMM",
      "name": "CARGO BAY / DATA VAULT",
      "service": "file-management-module",
      "realName": "C++ FTP-like file server",
      "port": 2121,
      "proto": "tcp",
      "desc": "Bulk cargo transfer + long-term data vault. Plaintext control connection.",
      "actions": [
        {
          "id": "login",
          "label": "Authenticate + PWD",
          "hint": "Opens a real control connection, logs in over the wire, and reads the working directory.",
          "fields": [
            {
              "name": "user",
              "label": "user",
              "default": "alice"
            },
            {
              "name": "pass",
              "label": "password",
              "default": "password123"
            }
          ]
        },
        {
          "id": "sess",
          "label": "Resume session",
          "hint": "SESS the issued token on a fresh control connection, then PWD.",
          "fields": [
            {
              "name": "token",
              "label": "token",
              "default": ""
            }
          ]
        },
        {
          "id": "list",
          "label": "LIST directory",
          "hint": "SESS, optional TYPE, PASV or PORT, then LIST. Returns names including . and ..",
          "fields": [
            {
              "name": "token",
              "label": "token",
              "default": ""
            },
            {
              "name": "type",
              "label": "type I/A",
              "default": "I",
              "options": [
                "I",
                "A"
              ]
            },
            {
              "name": "channel",
              "label": "channel",
              "default": "pasv",
              "options": [
                "pasv",
                "port"
              ]
            }
          ]
        },
        {
          "id": "cwd",
          "label": "CWD then LIST",
          "hint": "SESS, CWD, PWD, then the same LIST path as list.",
          "fields": [
            {
              "name": "token",
              "label": "token",
              "default": ""
            },
            {
              "name": "dir",
              "label": "dir",
              "default": "docs"
            },
            {
              "name": "type",
              "label": "type I/A",
              "default": "I",
              "options": [
                "I",
                "A"
              ]
            },
            {
              "name": "channel",
              "label": "channel",
              "default": "pasv",
              "options": [
                "pasv",
                "port"
              ]
            }
          ]
        },
        {
          "id": "retr",
          "label": "RETR file",
          "hint": "SESS, TYPE, PASV or PORT, then RETR. Preview is replacement-decoded text, never markup.",
          "fields": [
            {
              "name": "token",
              "label": "token",
              "default": ""
            },
            {
              "name": "filename",
              "label": "filename",
              "default": "welcome.txt"
            },
            {
              "name": "type",
              "label": "type I/A",
              "default": "I",
              "options": [
                "I",
                "A"
              ]
            },
            {
              "name": "channel",
              "label": "channel",
              "default": "pasv",
              "options": [
                "pasv",
                "port"
              ]
            }
          ]
        },
        {
          "id": "stor",
          "label": "STOR file",
          "hint": "SESS, TYPE, PASV or PORT, then STOR. Empty body uses a short ASCII probe.",
          "fields": [
            {
              "name": "token",
              "label": "token",
              "default": ""
            },
            {
              "name": "filename",
              "label": "filename",
              "default": "probe.txt"
            },
            {
              "name": "body",
              "label": "body",
              "default": "cargo from auditor-7\n"
            },
            {
              "name": "type",
              "label": "type I/A",
              "default": "I",
              "options": [
                "I",
                "A"
              ]
            },
            {
              "name": "channel",
              "label": "channel",
              "default": "pasv",
              "options": [
                "pasv",
                "port"
              ]
            }
          ]
        },
        {
          "id": "type",
          "label": "TYPE I/A",
          "hint": "SESS, then TYPE. Connection-local; the interactor QUITs, so the 3D page also sends type on each data-channel call.",
          "fields": [
            {
              "name": "token",
              "label": "token",
              "default": ""
            },
            {
              "name": "code",
              "label": "code",
              "default": "I",
              "options": [
                "I",
                "A"
              ]
            }
          ]
        }
      ]
    },
    {
      "code": "IPM",
      "name": "OPTICAL SENSOR ARRAY",
      "service": "image-processing-module",
      "realName": "Java/Spring image converter (ImageMagick)",
      "port": 8080,
      "proto": "http",
      "desc": "Processes optical feeds via ImageMagick; stores results in the Cargo Bay.",
      "actions": [
        {
          "id": "convert",
          "label": "Convert test image",
          "hint": "Uploads a canned image (1x1 PNG by default), converts it via ImageMagick, STORs the result into FMM, and retrieves it back through GET /image/{name}. Optional source: probe | svg | a plate key.",
          "fields": [
            {
              "name": "name",
              "label": "output name",
              "default": "probe.png"
            },
            {
              "name": "width",
              "label": "width",
              "default": "64"
            },
            {
              "name": "height",
              "label": "height",
              "default": "64"
            },
            {
              "name": "format",
              "label": "format",
              "default": ""
            },
            {
              "name": "filename",
              "label": "upload filename",
              "default": "",
              "hint": "multipart image filename; empty keeps canned name"
            },
            {
              "name": "image_b64",
              "label": "image (base64)",
              "default": ""
            },
            {
              "name": "source",
              "label": "canned source",
              "default": "probe"
            }
          ]
        },
        {
          "id": "convert-url",
          "label": "Convert from URL",
          "hint": "IPM fetches this URL server-side, converts it, and STORs the result into FMM.",
          "fields": [
            {
              "name": "url",
              "label": "url"
            },
            {
              "name": "name",
              "label": "output name",
              "default": ""
            },
            {
              "name": "width",
              "label": "width",
              "default": ""
            },
            {
              "name": "height",
              "label": "height",
              "default": ""
            },
            {
              "name": "format",
              "label": "format",
              "default": ""
            }
          ]
        },
        {
          "id": "convert-batch",
          "label": "Convert deck zip",
          "hint": "POSTs a zip archive to /convert-batch. Empty source is the unit-test two-PNG probe; source=deck is the four-plate deck. Each member is converted and STORd into FMM.",
          "fields": [
            {
              "name": "source",
              "label": "archive",
              "default": ""
            },
            {
              "name": "archive_b64",
              "label": "archive (base64)",
              "default": "",
              "hint": "optional; empty uses source=deck or two-PNG probe"
            },
            {
              "name": "filename",
              "label": "zip filename",
              "default": ""
            }
          ]
        },
        {
          "id": "image",
          "label": "Retrieve stored plate",
          "hint": "GET /image/{name} \u2014 RETR the named plate back out of FMM after IPM STORd it.",
          "fields": [
            {
              "name": "name",
              "label": "name"
            }
          ]
        },
        {
          "id": "health",
          "label": "Liveness",
          "hint": "GET /health on the Image Processing Module.",
          "fields": []
        }
      ]
    },
    {
      "code": "DNSM",
      "name": "NAV BEACON / COMMS ARRAY",
      "service": "dns-module",
      "realName": "C authoritative DNS server",
      "port": 8053,
      "adminPort": 8054,
      "proto": "dns",
      "desc": "Authoritative navigation beacon. Answers A/AAAA/TXT/MX/NS/CNAME over the DNS wire; HTTP admin import/reload on the admin port.",
      "actions": [
        {
          "id": "query",
          "label": "DNS query",
          "hint": "Sends a real DNS packet (UDP, or TCP when the answer is truncated) and decodes the answer section.",
          "fields": [
            {
              "name": "name",
              "label": "name",
              "default": "www.example.com"
            },
            {
              "name": "type",
              "label": "type",
              "default": "A",
              "options": [
                "A",
                "AAAA",
                "TXT",
                "MX",
                "NS",
                "CNAME"
              ]
            }
          ]
        },
        {
          "id": "import",
          "label": "Import zone",
          "hint": "POST /admin/import with zone text; the records are merged into the live zone. Signed in with the console's admin token.",
          "fields": [
            {
              "name": "body",
              "label": "zone text",
              "default": "",
              "placeholder": "www  A  192.0.2.10"
            }
          ]
        },
        {
          "id": "reload",
          "label": "Reload zone",
          "hint": "POST /admin/reload: reload the zone file from disk. Signed in with the console's admin token.",
          "fields": []
        }
      ]
    },
    {
      "code": "KVS",
      "name": "CORE MEMORY BANKS",
      "service": "keystore-module",
      "realName": "Go RESP key-value store",
      "port": 6379,
      "proto": "tcp",
      "desc": "Ship's core memory. Redis-protocol (RESP) over raw TCP.",
      "actions": [
        {
          "id": "cmd",
          "label": "RESP terminal",
          "hint": "Encodes your command as RESP, sends it to the real store, and decodes the reply.",
          "fields": [
            {
              "name": "command",
              "label": "command",
              "default": "PING",
              "placeholder": "e.g. SET ship online  |  GET ship  |  KEYS *"
            },
            {
              "name": "password",
              "label": "password (optional AUTH)",
              "default": "",
              "placeholder": "blank = the console's own sign-in; each call is a new TCP socket"
            },
            {
              "name": "script",
              "label": "EVAL script (optional)",
              "default": "",
              "placeholder": "Lua bulk for EVAL"
            }
          ]
        }
      ]
    },
    {
      "code": "LOG",
